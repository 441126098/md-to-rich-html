<!DOCTYPE html>
<html lang="en" data-theme="{{ theme }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content="md-to-rich-html">
  <title>{{ title }}</title>
  <style>{{ style_css | safe }}</style>
</head>
<body class="layout-{{ layout }}">

<header class="topbar">
  <div class="topbar-inner">
    <h1 class="doc-title">{{ title }}</h1>
    <div class="topbar-actions">
      {% if detectors %}
        <div class="detector-badges" title="Auto-detected patterns">
          {% for d in detectors %}
            <span class="badge badge-{{ d }}">{{ d }}</span>
          {% endfor %}
        </div>
      {% endif %}
      <button class="theme-toggle" type="button" aria-label="Toggle theme">
        <span class="theme-icon-light" aria-hidden="true">☼</span>
        <span class="theme-icon-dark" aria-hidden="true">☾</span>
      </button>
    </div>
  </div>
  {% if tasks.has_tasks %}
    <div class="tasks-progress" role="progressbar"
         aria-valuenow="{{ tasks.pct }}" aria-valuemin="0" aria-valuemax="100">
      <div class="tasks-progress-bar" style="width: {{ tasks.pct }}%"></div>
      <div class="tasks-progress-label">
        <strong>{{ tasks.done }}</strong> / {{ tasks.total }} tasks
        <span class="tasks-progress-pct">· {{ tasks.pct }}%</span>
      </div>
    </div>
  {% endif %}
</header>

{% if layout == "report" %}
<section class="report-hero">
  <div class="report-hero-inner">
    <div class="report-kicker">Technical Report</div>
    <h1>{{ title }}</h1>
    <div class="report-meta">
      <span>{{ docs|length }} source file{% if docs|length != 1 %}s{% endif %}</span>
      {% if toc %}<span>{{ toc|length }} sections</span>{% endif %}
      {% if detectors %}
        {% for d in detectors %}
          <span>{{ d }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<div class="layout">
  {% if toc %}
    <aside class="toc">
      <div class="toc-title">Contents</div>
      <ol class="toc-list">
        {% for entry in toc %}
          <li class="toc-l{{ entry.level }}">
            <a href="#{{ entry.anchor }}">{{ entry.text }}</a>
          </li>
        {% endfor %}
      </ol>
    </aside>
  {% endif %}

  {% if layout == "report" %}
    <main class="content report-content">
      {% for doc in docs %}
        {% if docs|length > 1 %}
          <div class="doc-separator" data-source="{{ doc.path }}"></div>
        {% endif %}
        {% if doc.intro_html %}
          <section class="report-overview">
            <div class="report-section-label">Overview</div>
            {{ doc.intro_html | safe }}
          </section>
        {% endif %}
        {% for section in doc.sections %}
          <section class="report-section report-section-{{ section.kind }}" id="report-{{ section.anchor }}">
            <div class="report-section-head">
              <span class="report-section-index">{{ "%02d"|format(section.index) }}</span>
              <div>
                <div class="report-section-label">{{ section.kind }}</div>
                {{ section.heading_html | safe }}
              </div>
            </div>
            <div class="report-section-body">
              {{ section.body_html | safe }}
            </div>
          </section>
        {% endfor %}
      {% endfor %}
    </main>
  {% else %}
    <main class="content">
      {% for doc in docs %}
        {% if docs|length > 1 %}
          <div class="doc-separator" data-source="{{ doc.path }}"></div>
        {% endif %}
        {{ doc.html | safe }}
      {% endfor %}
    </main>
  {% endif %}
</div>

<footer class="footer">
  <span class="footer-text">Generated by md-to-rich-html</span>
</footer>

{% if has_mermaid %}
  {% if mermaid_js %}
<script>{{ mermaid_js | safe }}</script>
  {% else %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/mermaid/10.9.1/mermaid.min.js"></script>
  {% endif %}
<script>
  (function () {
    if (typeof mermaid === 'undefined') return;
    const isDark = document.documentElement.dataset.theme === 'dark' ||
      (document.documentElement.dataset.theme === 'auto' &&
        window.matchMedia('(prefers-color-scheme: dark)').matches);
    mermaid.initialize({
      startOnLoad: true,
      theme: isDark ? 'dark' : 'default',
      securityLevel: 'strict',
      flowchart: { curve: 'basis' }
    });
  })();
</script>
{% endif %}

<script>{{ theme_js | safe }}</script>
</body>
</html>
